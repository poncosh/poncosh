# Nginx terminates direct TLS, then reaches portfolio-poncosh.internal through
# WireGuard. URL-encode the password. Requires node-postgres with direct TLS.
DATABASE_URL=postgresql://portfolio_app:CHANGE_ME@db-gateway.example.com:6432/postgres?sslmode=verify-full&sslnegotiation=direct
DATABASE_SSL=true
DATABASE_POOL_MAX=15
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_MAX_LIFETIME_SECONDS=300
NEXT_PUBLIC_SITE_URL=https://poncosh.vercel.app
