    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.7",
    "@fluentui/react-icons": "2.0.339",
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "node-cache": "^5.1.2",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sanitize-html": "2.16.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.34.0",
    "eslint-config-next": "16.3.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
